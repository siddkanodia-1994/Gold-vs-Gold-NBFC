# Neon Postgres connection string (set automatically when you add Neon from the
# Vercel project's Storage tab). Without it the app runs read-only on
# data/seed-history.json.
DATABASE_URL=

# Shared secret for /admin and /api/admin/* (sent as the x-admin-secret header).
ADMIN_SECRET=

# Encrypts the DHAN client ID and token at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# Sent by Vercel Cron as a Bearer token to /api/cron/sync-shares.
CRON_SECRET=
